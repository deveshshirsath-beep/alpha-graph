{
  "name": "atlas-graph-explorer-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "predev": "npm run prepare-data",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare-data",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:api": "node scripts/check-planner-api.mjs",
    "test:starters": "node scripts/check-starter-questions.mjs",
    "test:catalog": "node scripts/audit-question-bank.mjs",
    "test:catalog-regressions": "node scripts/check-catalog-regressions.mjs",
    "test:release": "npm run test:all && npm run test:proxy && npm run test:api && npm run test:starters && npm run test:catalog-regressions && npm run test:catalog",
    "test:proxy": "python3 -m unittest discover -s tests/server -v",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "graphology": "0.25.4",
    "sigma": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "10.10.0",
    "globals": "^17.12.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
