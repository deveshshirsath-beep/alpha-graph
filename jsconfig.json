{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.js", "scripts/**/*.mjs", "*.config.js"],
  "exclude": ["node_modules", "dist", "tests", "public/graph-data"]
}
